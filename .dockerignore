# Keep the build context small and prevent secrets or local state from being
# baked into an image layer.

.git/
.github/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
*.egg-info/
build/
dist/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

tests/
docs/
examples/
scripts/
packaging/

*.md
!README.md

.env
*.log
*.prom
config/agent.local.toml

.vscode/
.idea/
.DS_Store

Dockerfile
docker-compose*.yml
.dockerignore
Makefile
