# Shell scripts and systemd units are consumed by Linux and MUST use LF endings,
# regardless of the platform they were authored on. A CRLF in a script with a
# shebang produces the notoriously confusing:
#   /bin/bash^M: bad interpreter: No such file or directory
* text=auto eol=lf

*.sh          text eol=lf
*.bash        text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf
*.py          text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf

# Binary
*.png         binary
*.jpg         binary
*.gz          binary

# Keep generated docs out of language statistics
docs/*.md     linguist-documentation
